# Copy to .env before `docker compose up -d` (compose reads it automatically).
# All values are optional — defaults are shown.

# Where your Ollama models live on the host (absolute path)
MODELS_DIR=/mnt/user/appdata/ollama/models

# Ollama version to build (optional — Dockerfile ARG has a default)
OLLAMA_VERSION=0.34.2

# Port Ollama listens on (host side)
OLLAMA_PORT=11434

# Device pinning. Multiple devices: level_zero:0;level_zero:1
ONEAPI_DEVICE_SELECTOR=level_zero:0

# Idle unload time; -1 = never unload
OLLAMA_KEEP_ALIVE=10m

# KV cache quantization (requires FLASH_ATTENTION=true)
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=true

# Max context length
OLLAMA_CONTEXT_LENGTH=4096

# Parallel slots
OLLAMA_NUM_PARALLEL=1

# CORS origins for web UIs (Open WebUI, etc.)
OLLAMA_ORIGINS=*
