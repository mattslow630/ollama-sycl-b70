# Copy to .env and adjust
MODELS_DIR=/mnt/user/appdata/ollama-sycl/models
OLLAMA_PORT=11434
OLLAMA_VERSION=0.34.2
# level_zero:0 = first enumerated GPU. If you have an Intel iGPU, the Arc card
# may be level_zero:1 — check with: docker run --rm --device /dev/dri -it <image> clinfo
ONEAPI_DEVICE_SELECTOR=level_zero:0
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_NUM_PARALLEL=1
OLLAMA_ORIGINS=*
